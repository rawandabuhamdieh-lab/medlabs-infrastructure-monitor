# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MEDLABS_ADMIN_PASSCODE: Optional initial Administrator passcode for the IT Infrastructure Intelligence portal.
# Leave empty during preview to claim the initial Administrator password via the inline setup form.
MEDLABS_ADMIN_PASSCODE=

# ORACLE_CONNECTION_STRING: Optional default ODP.NET / Oracle Thin read-only connection string (never commit real credentials).
ORACLE_CONNECTION_STRING=

# MEDLABS_VAULT_KEY: Server-side secret key used to encrypt stored monitoring credentials (AES-256-GCM).
MEDLABS_VAULT_KEY=
